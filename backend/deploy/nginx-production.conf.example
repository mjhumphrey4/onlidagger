# Production template. Replace the hostname and PHP-FPM socket before enabling.
# Obtain the certificate with Certbot, then point ssl_certificate paths at it.
server {
    listen 80;
    listen [::]:80;
    server_name mt5.example.com;

    # Keep HTTP available for ACME renewal and redirect all app traffic to TLS.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name mt5.example.com;
    root /var/www/onlidagger/frontend/dist;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/mt5.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mt5.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:TLS:10m;
    ssl_session_tickets off;

    client_max_body_size 1m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # EA endpoints are reachable remotely and authenticate with per-account
    # bearer tokens. Preserve the Authorization header for PHP-FPM.
    location ^~ /api/ea/ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/onlidagger/backend/public/index.php;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    # Browser API has no login screen. Keep it private at the network boundary.
    location ^~ /api/ {
        allow 127.0.0.1;
        allow ::1;
        allow 100.64.0.0/10;
        deny all;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/onlidagger/backend/public/index.php;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    # Serve only the independently built frontend; keep PHP source outside the
    # document root. Restrict the app UI to the same operator network.
    location / {
        allow 127.0.0.1;
        allow ::1;
        allow 100.64.0.0/10;
        deny all;
        try_files $uri $uri/ /index.html;
        expires 1h;
    }

    location ~ \.php$ { return 404; }
    location ~ /\. { deny all; }
}
